+/*
+ * Gives the compression session the bit_rate of the codec context when the
+ * caller changed it after the session was created, also before its first
+ * frame. The session takes the new rate from the next frame on, with no key
+ * frame.
+ */
+static void vtenc_follow_bit_rate(AVCodecContext *avctx, VTEncContext *vtctx)
+{
+    CFStringRef key;
+    CFNumberRef number;
+    SInt32      rate;
+    OSStatus    status;
+
+    if (avctx->codec_id == AV_CODEC_ID_PRORES || avctx->bit_rate <= 0 ||
+        !vtctx->session_bit_rate || vtctx->session_bit_rate == avctx->bit_rate)
+        return;
+
+    key = vtctx->constant_bit_rate ? compat_keys.kVTCompressionPropertyKey_ConstantBitRate
+                                   : kVTCompressionPropertyKey_AverageBitRate;
+    rate = (SInt32)FFMIN(avctx->bit_rate, INT32_MAX);
+    number = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &rate);
+    if (!number)
+        return;
+    status = VTSessionSetProperty(vtctx->session, key, number);
+    CFRelease(number);
+    if (!status) {
+        vtctx->session_bit_rate = avctx->bit_rate;
+        vtctx->refused_bit_rate = 0;
+    } else if (vtctx->refused_bit_rate != avctx->bit_rate) {
+        /* The next frame tries again; the warning comes once per rate. */
+        av_log(avctx, AV_LOG_WARNING, "Cannot change the bit rate to %"PRId64": %d\n",
+               avctx->bit_rate, (int)status);
+        vtctx->refused_bit_rate = avctx->bit_rate;
+    }
+}
+
