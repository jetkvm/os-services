#!/usr/bin/env bash
# Signs an AppImage in place, in the form that appimagetool defines and that
# the service on Linux checks before it installs an update
# (src/supervisor/publisher):
#
#   .sha256_sig  an armored OpenPGP signature over the SHA-256 of the image,
#                written in hex and computed with both sections as zeros
#   .sig_key     the armored key block of the release key
#
# The AppImage runtime reserves both sections, and `--appimage-signature`
# prints the signature.
#
# Usage: scripts/sign-appimage IMAGE SIGNING_KEY RELEASE_KEY
#
# SIGNING_KEY is what gpg --local-user takes; RELEASE_KEY is the fingerprint
# of the primary key that the signing key belongs to.
set -euo pipefail

fail() { printf 'Error: %s\n' "$1" >&2; exit 1; }
[[ $# == 3 ]] || fail "usage: scripts/sign-appimage IMAGE SIGNING_KEY RELEASE_KEY"
image="$1" signing_key="$2" release_key="$3"
for command in awk dd gpg readelf sed sha256sum; do
  command -v "$command" >/dev/null 2>&1 || fail "Missing required command: $command"
done
[[ -f "$image" ]] || fail "No such file: $image"

# Prints the offset and the size of a section in the file, in decimal.
section() {
  local offset size
  read -r offset size < <(readelf --section-headers --wide "$image" \
    | sed 's/^ *\[ *[0-9]*\] *//' | awk -v name="$1" '$1 == name { print $4, $5 }') || true
  [[ -n "${size:-}" ]] || fail "$(basename "$image") has no $1 section"
  printf '%d %d\n' "$((16#$offset))" "$((16#$size))"
}

# Fills a section with the bytes of a file, and with zeros behind them.
write_section() {
  local name="$1" data="$2" offset size length
  read -r offset size < <(section "$name")
  length="$(wc -c < "$data")"
  (( length <= size )) || fail "$name holds $size bytes, and $(basename "$data") has $length"
  dd if=/dev/zero of="$image" bs=1 seek="$offset" count="$size" conv=notrunc status=none
  dd if="$data" of="$image" bs=1 seek="$offset" conv=notrunc status=none
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
: > "$work/empty"
write_section .sha256_sig "$work/empty"
write_section .sig_key "$work/empty"
sha256sum "$image" | awk '{ printf "%s", $1 }' > "$work/digest"
gpg --yes --armor --textmode --local-user "$signing_key" --output "$work/signature.asc" \
  --detach-sign "$work/digest"
gpg --status-fd 1 --verify "$work/signature.asc" "$work/digest" 2>/dev/null \
  | awk -v key="$release_key" '$2 == "VALIDSIG" && $12 == key { found = 1 } END { exit !found }' \
  || fail "The signature is not from a key of $release_key"
gpg --armor --export-options export-minimal --export "$release_key" > "$work/key.asc"
[[ -s "$work/key.asc" ]] || fail "The public key $release_key is not in the GPG keyring"
write_section .sha256_sig "$work/signature.asc"
write_section .sig_key "$work/key.asc"
