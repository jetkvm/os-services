+/// Changes the watch on `fd` to edge-triggered: the event thread then gets
+/// one event for each wake-up of the file, not events for as long as the
+/// file is ready.
+pub(super) fn watch_edges(fd: BorrowedFd, tag: Tag, flags: EventFlags) -> Result<(), Errno> {
+    let epoll_fd = EPOLL_FD.get().unwrap();
+    epoll::modify(epoll_fd, fd, tag.as_event_data(), flags | EventFlags::ET)
+}
+
 pub(super) fn unregister_fd(fd: BorrowedFd) {
     let epoll_fd = EPOLL_FD.get().unwrap();
     epoll::delete(epoll_fd, fd).ok();
